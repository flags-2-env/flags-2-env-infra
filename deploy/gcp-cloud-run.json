{
  "schemaVersion": "ores.gcp-cloud-run.org.v1",
  "organization": "flags-2-env",
  "infraRepository": "flags-2-env/flags-2-env-infra",
  "canonicalDeploymentRepository": "ORESoftware/k8s-cluster",
  "centralModulePath": "gcp/cloud-run-rust-service",
  "gcp": {
    "projectId": null,
    "region": "us-central1",
    "state": "planned"
  },
  "services": [
    {
      "role": "web-server",
      "repository": "flags-2-env/flags-2-env-web-server.rs",
      "serviceName": "flags-2-env-web-server",
      "repositoryState": "present",
      "ingress": "public"
    },
    {
      "role": "admin-web-server",
      "repository": "flags-2-env/flags-2-env-admin-web-server.rs",
      "serviceName": "flags-2-env-admin-web-server",
      "repositoryState": "present",
      "ingress": "private"
    },
    {
      "role": "api-server",
      "repository": "flags-2-env/flags-2-env-api-server.rs",
      "serviceName": "flags-2-env-api-server",
      "repositoryState": "present",
      "ingress": "public"
    },
    {
      "role": "admin-api-server",
      "repository": "flags-2-env/flags-2-env-admin-api-server.rs",
      "serviceName": "flags-2-env-admin-api-server",
      "repositoryState": "present",
      "ingress": "private"
    }
  ],
  "probes": {
    "startup": {
      "path": "/startupz",
      "failureStatus": 503
    },
    "liveness": {
      "path": "/healthz",
      "dependencyFree": true
    },
    "readiness": {
      "path": "/readyz",
      "failureStatus": 503
    },
    "buildIdentity": {
      "path": "/version",
      "cacheControl": "no-store"
    },
    "metrics": {
      "path": "/metrics",
      "exposure": "private"
    }
  },
  "runtime": {
    "minInstances": 0,
    "maxInstances": 10,
    "imagePolicy": "digest-only",
    "serviceAccountPolicy": "per-service",
    "terminationGraceSeconds": 45,
    "readinessBeforeDrain": true
  },
  "kubernetes": {
    "startupPath": "/startupz",
    "livenessPath": "/healthz",
    "readinessPath": "/readyz"
  },
  "neon": {
    "organization": "flags-2-env",
    "project": "flags-2-env-prod",
    "database": "app",
    "state": "pending-external-provisioning"
  }
}
